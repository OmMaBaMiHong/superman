DATABASE_URL=postgresql://feedfuse:feedfuse@127.0.0.1:5432/feedfuse
AUTH_INITIAL_PASSWORD=change-me-before-first-login
AUTH_COOKIE_SECURE=false
IMAGE_PROXY_SECRET=change-me-before-prod
RSS_NETWORK_MODE=public
RSS_ALLOWED_CIDRS=

# 应用级加密密钥，用于加密 GitHub Token 等敏感凭据（AES-256-GCM）。
# 取值为 32 字节密钥：64 位十六进制字符串，或等长的 base64。
# 生成方式：openssl rand -hex 32
# 留空时自动回落到数据库 app_settings.secret_encryption_key（首次使用自动生成），
# 保证零配置即可运行；但生产环境强烈建议改用本环境变量注入，
# 让密钥与被加密的数据物理分离。修改此值会导致已加密的历史凭据无法解密，需重新录入。
FEEDFUSE_SECRET_KEY=

# GitHub API 基址。默认 https://api.github.com；
# 指向 GitHub Enterprise Server 时修改此项，外呼主机白名单会自动从这里派生。
GITHUB_API_BASE_URL=https://api.github.com

# 以下两项可选，通常无需修改
# GITHUB_USER_AGENT=FeedFuse/0.4
# GITHUB_API_TIMEOUT_MS=15000

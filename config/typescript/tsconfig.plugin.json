{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": "../../dist/plugin",
    "rootDir": "../../src/plugin",
    "types": ["node"],
    "incremental": false
  },
  "include": ["../../src/plugin/host/**/*.ts"]
}

{
  "name": "superman",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "rsshub:build": "pnpm --dir vendor/rsshub build:lib",
    "dev": "pnpm rsshub:build && WATCHPACK_POLLING=true next dev --webpack -p 9559",
    "dev:turbo": "pnpm rsshub:build && next dev -p 9559",
    "build:clean": "node scripts/build/clean-build-artifacts.mjs",
    "build": "pnpm build:clean && pnpm rsshub:build && next build",
    "start": "next start -p 9559",
    "worker:dev": "tsx --tsconfig config/typescript/tsconfig.json src/worker/index.ts",
    "worker:start": "tsx --tsconfig config/typescript/tsconfig.json src/worker/index.ts",
    "lint": "eslint . --no-config-lookup --config config/eslint/eslint.config.js",
    "type-check": "tsc --noEmit -p config/typescript/tsconfig.typecheck.json",
    "pretest": "node scripts/check-node-version.mjs",
    "pretest:unit": "node scripts/check-node-version.mjs",
    "test": "vitest run --config config/vitest/vitest.config.ts",
    "test:unit": "vitest run --config config/vitest/vitest.config.ts",
    "test:unit:watch": "vitest --config config/vitest/vitest.config.ts",
    "test:relocate": "node scripts/testing/relocate-tests.mjs"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@whisper-cpp-node/core": "^0.2.0",
    "@whisper-cpp-node/darwin-arm64": "^0.2.12",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "got": "^14.6.6",
    "i18next": "^26.3.6",
    "i18next-resources-to-backend": "^1.2.3",
    "ipaddr.js": "^2.3.0",
    "jsdom": "^28.1.0",
    "ky": "^1.14.3",
    "lucide-react": "^0.575.0",
    "marked": "^16.4.2",
    "next": "16.1.6",
    "openai": "^6.25.0",
    "pg": "^8.18.0",
    "pg-boss": "^12.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.11",
    "rss-parser": "^3.13.0",
    "rsshub": "workspace:*",
    "sanitize-html": "^2.17.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "ytdlp-nodejs": "^3.4.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.18"
  }
}
